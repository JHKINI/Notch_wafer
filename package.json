    "test": "node --test test/core.test.mjs",
    "test:e2e": "node build.mjs && python3 test/e2e.py",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "typescript": ">=5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
